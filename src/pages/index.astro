---
import Base from "@/layouts/Base.astro";
import { NoiseField } from "@/components/dithercn/noise-field";
import SectionHead from "@/components/SectionHead.astro";
import { Fire } from "@/components/dithercn/fire";

// Placeholder content for the design prototype.
const experience = [
  {
    period: "2025 – now",
    role: "Founding Engineer",
    company: "Acme Labs",
    summary: "Building the core platform from zero: infra, product, and the first ten customers.",
    latest: true,
  },
  {
    period: "2023 – 2025",
    role: "Senior Software Engineer",
    company: "Northwind",
    summary: "Led the move to an event-driven backend and cut p95 latency by 60%.",
  },
  {
    period: "2021 – 2023",
    role: "Software Engineer",
    company: "Globex",
    summary: "Shipped the payments SDK used by 2k+ merchants.",
  },
  {
    period: "2020",
    role: "Engineering Intern",
    company: "Initech",
    summary: "Internal tooling for deploys and feature flags.",
  },
];

const projects = [
  { name: "flakes", description: "nix templates for dev shells", meta: "nix" },
  { name: "tinyq", description: "a job queue in 400 lines of Go", meta: "go" },
  { name: "shelf", description: "self-hosted read-later app", meta: "ts" },
  { name: "pixl", description: "dithered image exporter", meta: "rust" },
];

const writing = [
  { title: "Notes on building a job queue", date: "Oct 2026" },
  { title: "Why I moved my dev setup to Nix", date: "Aug 2026" },
  { title: "Small tools, sharp edges", date: "May 2026" },
];

const links = [
  { label: "GitHub", href: "https://github.com/ishaksebsib", handle: "@ishaksebsib" },
  { label: "X", href: "#", handle: "@handle" },
  { label: "LinkedIn", href: "#", handle: "in/handle" },
  { label: "Email", href: "#", handle: "hello@example.com" },
];
---

<Base title="Ishak — Software Engineer" description="Software engineer building products from zero.">
  <div class="rails">
    <header class="column top">
      <div class="identity">
        <div class="avatar" aria-hidden="true">IS</div>
        <div>
          <p class="name">Ishak Sebsib</p>
          <p class="role">Founding Engineer, Acme Labs</p>
        </div>
      </div>
      <button class="theme-toggle" type="button" aria-label="Toggle theme">
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </header>

    <section class="band">
      <NoiseField
        client:visible
        color="--line"
        intensity={0.9}
        scale={1.6}
        style={{ position: "absolute", inset: 0 }}
      />
      <div class="column frame">
        <span class="corner tl"></span><span class="corner tr"></span>
        <span class="corner bl"></span><span class="corner br"></span>

        <div class="frame-body">
          <a class="announce" href="#work">
            <span class="dot"></span>
            Currently building Acme Labs
            <span aria-hidden="true">›</span>
          </a>
          <h1 class="statement">
            Building <a href="#">Acme Labs</a>, tools that help small teams ship{" "}
            <span class="hand">without the chaos.</span>
          </h1>
          <p class="statement muted">
            Before that: backend systems at Northwind and payments infrastructure at Globex.
          </p>
          <nav class="tags" aria-label="Sections">
            <a href="#work">Changelog</a>
            <a href="#projects">Projects</a>
            <a href="#writing">Writing</a>
            <a href="#connect">Connect</a>
          </nav>
        </div>

        <Fire client:visible cell={4} height={0.8} style={{ height: "150px" }} />
        <NoiseField
          client:visible
          color="--line"
          intensity={0.9}
          scale={3}
          style={{ height: "28px", borderTop: "1px solid var(--line)" }}
        />
      </div>
    </section>

    <main class="content">
      <section id="work">
        <SectionHead label="Changelog / Experience" />
        <div class="column body">
        <ol class="timeline">
          {experience.map((job) => (
            <li class:list={["entry", { latest: job.latest }]}>
              <span class="period">{job.period}</span>
              <span class="node" aria-hidden="true"></span>
              <div>
                <p class="entry-title">
                  {job.latest && <span class="badge">Latest</span>}
                  <strong>{job.role}</strong>
                  <span class="dim"> · {job.company}</span>
                </p>
                <p class="dim">{job.summary}</p>
              </div>
            </li>
          ))}
        </ol>
        </div>
      </section>

      <section id="projects">
        <SectionHead label="Projects" />
        <div class="column body">
        <ul class="rows">
          {projects.map((project) => (
            <li>
              <a href="#">{project.name}</a>
              <span class="dim">{project.description}</span>
              <span class="meta">{project.meta}</span>
            </li>
          ))}
        </ul>
        </div>
      </section>

      <section id="writing">
        <SectionHead label="Writing" />
        <div class="column body">
        <ul class="rows">
          {writing.map((post) => (
            <li>
              <a href="#">{post.title}</a>
              <span class="meta">{post.date}</span>
            </li>
          ))}
        </ul>
        </div>
      </section>

      <section id="connect">
        <SectionHead label="Connect" />
        <div class="column body">
        <ul class="rows">
          {links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
              <span class="meta">{link.handle}</span>
            </li>
          ))}
        </ul>
        </div>
      </section>
    </main>

    <footer class="column footer">
      <span>© 2026 Ishak Sebsib</span>
      <span>City, Country · UTC+0</span>
    </footer>
  </div>
</Base>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>

<style>
  .rails {
    position: relative;
    min-height: 100vh;
  }

  /* Thin vertical rules framing the column, full page height. */
  .rails::before {
    content: "";
    position: absolute;
    inset: 0;
    left: 50%;
    width: min(var(--column), 100%);
    transform: translateX(-50%);
    border-inline: 1px solid var(--line);
    pointer-events: none;
  }

  .column {
    position: relative;
    width: min(var(--column), 100%);
    margin-inline: auto;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 56px var(--gutter) 28px;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--primary);
  }

  .name {
    font-weight: 500;
    line-height: 1.3;
  }

  .role {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.3;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--foreground);
  }

  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }

  /* Full-width hatched band behind the hero frame. */
  .band {
    position: relative;
    border-block: 1px solid var(--line);
  }

  .frame {
    background: var(--background);
    border-inline: 1px solid var(--line);
  }

  .frame-body {
    padding: 48px var(--gutter) 36px;
  }

  .announce {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .announce:hover {
    color: var(--foreground);
  }

  .dot {
    width: 6px;
    height: 6px;
    background: var(--primary);
    border-radius: 50%;
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 20%, transparent);
  }

  .statement {
    font-family: var(--font-serif);
    font-size: clamp(22px, 4.6vw, 27px);
    font-weight: 400;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }

  .statement + .statement {
    margin-top: 14px;
  }

  .statement.muted {
    color: var(--muted);
  }

  .hand {
    font-family: var(--font-hand);
    font-size: 1.2em;
    color: var(--primary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .tags a {
    padding: 4px 9px;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s, border-color 0.15s;
  }

  .tags a:hover {
    color: var(--foreground);
    border-color: var(--faint);
  }

  /* Sit flush under the hero; overlap 1px so the two border rules merge. */
  .content {
    margin-top: -1px;
  }

  .body {
    padding: 28px var(--gutter) 48px;
  }

  .dim {
    color: var(--muted);
  }

  .timeline {
    display: grid;
  }

  .entry {
    position: relative;
    display: grid;
    grid-template-columns: 92px 20px 1fr;
    padding-bottom: 22px;
  }

  /* Vertical line connecting the timeline nodes. */
  .entry::before {
    content: "";
    position: absolute;
    top: 14px;
    bottom: 0;
    left: 101px;
    width: 1px;
    background: var(--line);
  }

  .entry:last-child::before {
    display: none;
  }

  .period {
    padding-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    text-transform: uppercase;
  }

  .node {
    width: 7px;
    height: 7px;
    margin: 8px 0 0 7px;
    border: 1px solid var(--faint);
    border-radius: 50%;
    background: var(--background);
  }

  .latest .node {
    border-color: var(--primary);
    background: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 20%, transparent);
  }

  .entry-title strong {
    font-weight: 500;
  }

  .badge {
    margin-right: 8px;
    padding: 1px 6px;
    background: color-mix(in oklch, var(--primary) 12%, transparent);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
    vertical-align: 1px;
  }

  .rows {
    display: grid;
    gap: 10px;
  }

  .rows li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .rows a {
    text-decoration: none;
    white-space: nowrap;
  }

  .rows a:hover {
    color: var(--primary);
  }

  .rows .dim {
    overflow: hidden;
    font-size: 13.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .meta {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 20px var(--gutter) 40px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  @media (max-width: 520px) {
    .entry {
      grid-template-columns: 20px 1fr;
    }

    .period {
      grid-column: 2;
      padding-top: 0;
    }

    .node {
      grid-row: 1 / span 2;
      grid-column: 1;
    }

    .entry::before {
      left: 10px;
    }
  }
</style>
