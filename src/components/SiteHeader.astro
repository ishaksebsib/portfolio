<header class="column top">
  <a class="identity" href="/">
    <div class="avatar" aria-hidden="true">IS</div>
    <div>
      <p class="name">Ishak Sebsib</p>
      <p class="role">Full Stack AI Engineer, Turing</p>
    </div>
  </a>
  <div class="end">
  <nav class="nav" aria-label="Sections">
    <a href="/#projects">Projects</a>
    <a href="/#work">Changelog</a>
    {/* NOTE: re-enable with the Writing section. */}
    {/* <a href="/#writing">Writing</a> */}
    <a href="/#connect">Connect</a>
  </nav>
  <button class="theme-toggle" type="button" aria-label="Toggle theme">
    <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
    </svg>
    <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>
  </div>
</header>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 56px var(--gutter) 28px;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--primary);
  }

  .name {
    font-weight: 500;
    line-height: 1.3;
  }

  .role {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.3;
  }

  .end {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  /* Section links: quiet mono, same voice as the rest of the metadata. */
  .nav {
    display: flex;
    gap: 16px;
  }

  .nav a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.15s;
  }

  .nav a:hover {
    color: var(--foreground);
  }

  /* Phones: identity takes the row; links + toggle drop to their own line. */
  @media (max-width: 520px) {
    .top {
      flex-wrap: wrap;
      row-gap: 16px;
    }

    .end {
      width: 100%;
      justify-content: space-between;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--foreground);
  }

  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }
</style>
