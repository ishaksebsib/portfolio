<header class="column top">
  <a class="identity" href="/">
    <div class="avatar" aria-hidden="true">IS</div>
    <div>
      <p class="name">Ishak Sebsib</p>
      <p class="role">Founding Engineer, Acme Labs</p>
    </div>
  </a>
  <button class="theme-toggle" type="button" aria-label="Toggle theme">
    <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
    </svg>
    <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
  </button>
</header>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 56px var(--gutter) 28px;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--primary);
  }

  .name {
    font-weight: 500;
    line-height: 1.3;
  }

  .role {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.3;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--foreground);
  }

  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }
</style>
