<!-- One quiet line: wordmark home, section links, theme toggle. The hero does the introducing. -->
<header class="column top">
  <a class="wordmark" href="/">ishak.io</a>
  <div class="end">
    <nav class="nav" aria-label="Sections">
      <a href="/#projects">Projects</a>
      <a href="/#work">Changelog</a>
      {/* NOTE: re-enable with the Writing section. */}
      {/* <a href="/#writing">Writing</a> */}
      <a href="/#connect">Connect</a>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle theme">
      <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
      </svg>
      <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  document.querySelector(".theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 30px var(--gutter);
  }

  /* Mono, same voice as the nav, one step stronger so it reads as home. */
  .wordmark,
  .nav a {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: color 0.15s;
  }

  .wordmark {
    font-weight: 500;
    color: var(--foreground);
  }

  .end {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav {
    display: flex;
    gap: 18px;
  }

  .nav a {
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav a:hover,
  .wordmark:hover {
    color: var(--primary);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--foreground);
  }

  .sun,
  :global(.dark) .moon {
    display: none;
  }

  :global(.dark) .sun {
    display: block;
  }

  /* Phones: tighten gaps so everything stays on one line. */
  @media (max-width: 420px) {
    .end {
      gap: 14px;
    }

    .nav {
      gap: 12px;
    }

    .nav a {
      letter-spacing: 0.06em;
    }
  }
</style>
